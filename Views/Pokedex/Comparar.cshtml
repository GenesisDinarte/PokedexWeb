@model ComparacionFormulario

@{
    ViewData["Title"] = "Comparar";
}

<section class="compare-page">

    <div class="compare-header">
        <span class="poke-eyebrow">ARENA DE COMBATE</span>
        <h1>Enfrenta a tus <span>Pokémon</span></h1>
        <p>Dos rivales, una comparación. Descubre cuál tiene mejores estadísticas.</p>
    </div>

    <div class="compare-form-panel">
        <div class="compare-form-heading">
            <span>⚔</span>
            <div>
                <h2>Selecciona tus rivales</h2>
                <p>Escribe los nombres de los dos Pokémon que quieres enfrentar.</p>
            </div>
        </div>

        <form asp-action="Comparar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row align-items-center g-3">
                <div class="col-md-5">
                    <div class="compare-input-box">
                        <label asp-for="Pokemon1" class="form-label">PRIMER RIVAL</label>
                        <input asp-for="Pokemon1"
                               class="form-control compare-input"
                               placeholder="Ej. Pikachu" />
                        <span asp-validation-for="Pokemon1" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="compare-vs-small">VS</div>
                </div>

                <div class="col-md-5">
                    <div class="compare-input-box">
                        <label asp-for="Pokemon2" class="form-label">SEGUNDO RIVAL</label>
                        <input asp-for="Pokemon2"
                               class="form-control compare-input"
                               placeholder="Ej. Charizard" />
                        <span asp-validation-for="Pokemon2" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn compare-submit">
                ⚔ Iniciar enfrentamiento
            </button>
        </form>
    </div>

    @if (Model.Resultado != null)
    {
        var r = Model.Resultado;

        <section class="compare-results">

            <div class="compare-arena">
                <div class="compare-fighter">
                    <span class="fighter-label">RIVAL 01</span>
                    <img src="@r.Pokemon1.Imagen" alt="@r.Pokemon1.Nombre" />
                    <h2 class="text-capitalize">@r.Pokemon1.Nombre</h2>
                    <span class="fighter-total">@r.Pokemon1.TotalEstadisticas PTS</span>
                </div>

                <div class="compare-arena-vs">VS</div>

                <div class="compare-fighter">
                    <span class="fighter-label">RIVAL 02</span>
                    <img src="@r.Pokemon2.Imagen" alt="@r.Pokemon2.Nombre" />
                    <h2 class="text-capitalize">@r.Pokemon2.Nombre</h2>
                    <span class="fighter-total">@r.Pokemon2.TotalEstadisticas PTS</span>
                </div>
            </div>

            <div class="compare-verdict @(r.Ganador == "Empate" ? "draw" : "")">
                @if (r.Ganador == "Empate")
                {
                    <span class="verdict-icon">⚖</span>
                    <div>
                        <span class="verdict-label">RESULTADO DEL COMBATE</span>
                        <h2>¡Es un empate!</h2>
                        <p>Ambos Pokémon tienen el mismo total de estadísticas.</p>
                    </div>
                }
                else
                {
                    <span class="verdict-icon">🏆</span>
                    <div>
                        <span class="verdict-label">GANADOR DEL ENFRENTAMIENTO</span>
                        <h2 class="text-capitalize">@r.Ganador</h2>
                        <p>Supera a su rival por @r.Diferencia puntos de estadísticas totales.</p>
                    </div>
                }
            </div>

            <div class="compare-stats-heading">
                <span class="poke-eyebrow">ANÁLISIS DE RENDIMIENTO</span>
                <h2>Estadísticas de combate</h2>
                <p>Compara los valores de cada atributo.</p>
            </div>

            <div class="table-responsive compare-table-wrapper">
                <table class="table compare-table text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ATRIBUTO</th>
                            <th>
                                <span class="text-capitalize">@r.Pokemon1.Nombre</span>
                            </th>
                            <th>
                                <span class="text-capitalize">@r.Pokemon2.Nombre</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < r.Pokemon1.Estadisticas.Count; i++)
                        {
                            var v1 = r.Pokemon1.Estadisticas[i].Valor;
                            var v2 = r.Pokemon2.Estadisticas[i].Valor;

                            <tr>
                                <td class="text-capitalize stat-name">
                                    @r.Pokemon1.Estadisticas[i].Nombre
                                </td>
                                <td class="@(v1 > v2 ? "stat-winner" : "")">
                                    <strong>@v1</strong>
                                    @if (v1 > v2)
                                    {
                                        <span class="stat-indicator">▲</span>
                                    }
                                </td>
                                <td class="@(v2 > v1 ? "stat-winner" : "")">
                                    <strong>@v2</strong>
                                    @if (v2 > v1)
                                    {
                                        <span class="stat-indicator">▲</span>
                                    }
                                </td>
                            </tr>
                        }

                        <tr class="compare-total-row">
                            <td>TOTAL</td>
                            <td>@r.Pokemon1.TotalEstadisticas</td>
                            <td>@r.Pokemon2.TotalEstadisticas</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </section>
    }

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
